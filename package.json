{
  "name": "icloud-mail-mcp",
  "version": "0.1.0",
  "description": "Local MCP server that lets Claude Desktop on macOS read, search, organize, draft and send iCloud Mail over IMAP/SMTP",
  "author": "Seth",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build-dev.mjs",
    "pack": "node scripts/pack.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project integration test/integration/e2e-",
    "build:vercel": "node scripts/build-vercel.mjs",
    "vercel-build": "node scripts/build-vercel.mjs --skip-typecheck"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "html-to-text": "10.0.1",
    "imapflow": "2.1.0",
    "nodemailer": "10.0.11",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@modelcontextprotocol/client": "2.1.0",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.4.6",
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "mailparser": "3.9.29",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
